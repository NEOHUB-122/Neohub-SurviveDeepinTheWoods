--==================================================
-- HITBOX
-- No separate collision toggle.
-- Client-side changes may not replicate to server.
--==================================================

local function clearHitboxes()
    for _, data in pairs(hitboxObjects) do
        if data.box and data.box.Parent then
            data.box:Destroy()
        end
        if data.selection and data.selection.Parent then
            data.selection:Destroy()
        end
    end
    hitboxObjects = {}
end

local function refreshHitboxes()
    clearHitboxes()
    if not hitboxEnabled then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local root = getRoot(player)
            if root then
                local originalSize = root.Size

                root.Size = Vector3.new(
                    hitboxSize,
                    hitboxSize,
                    hitboxSize
                )

                local box
                if showHitbox then
                    box = create("BoxHandleAdornment", {
                        Name = "NEOHUB_HitboxVisual",
                        Adornee = root,
                        Size = root.Size,
                        Color3 = BLUE,
                        Transparency = 0.65,
                        AlwaysOnTop = true,
                        ZIndex = 5
                    }, gui)
                end

                hitboxObjects[player.UserId] = {
                    root = root,
                    originalSize = originalSize,
                    box = box
                }
            end
        end
    end
end

local function restoreHitboxes()
    for _, data in pairs(hitboxObjects) do
        if data.root and data.root.Parent then
            data.root.Size = data.originalSize
        end
        if data.box and data.box.Parent then
            data.box:Destroy()
        end
    end
    hitboxObjects = {}
end

