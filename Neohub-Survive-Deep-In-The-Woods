local function refreshNoclip()
    local character = getCharacter(LocalPlayer)
    if not character then return end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            if noclipEnabled then
                if noclipOriginal[object] == nil then
                    noclipOriginal[object] = object.CanCollide
                end
                object.CanCollide = false
            elseif noclipOriginal[object] ~= nil then
                object.CanCollide = noclipOriginal[object]
                noclipOriginal[object] = nil
            end
        end
    end
end

local elapsed = 0

RunService.Heartbeat:Connect(function(deltaTime)
    if not running then return end

    elapsed += deltaTime

    refreshNoclip()
    updateDetectorPosition()

    local root = getRoot(LocalPlayer)
    local humanoid = getHumanoid(LocalPlayer)

    if root and humanoid then
        -- Save only grounded positions above the void.
        if humanoid.FloorMaterial ~= Enum.Material.Air
            and root.Position.Y > -30 then
            safeCFrame = root.CFrame
        end

        if antiVoid and root.Position.Y < -40 and safeCFrame then
            root.CFrame = safeCFrame
        end
    end

    if elapsed >= 0.25 then
        elapsed = 0

        -- Update distance labels.
        if espSurvivors then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local key = "survivor_" .. player.UserId
                    local data = espObjects[key]
                    local myRoot = getRoot(LocalPlayer)
                    local targetRoot = getRoot(player)

                    if data and data[3] and myRoot and targetRoot then
                        local distance = math.floor(
                            (myRoot.Position - targetRoot.Position).Magnitude
                        )

                        data[3].Text = player.DisplayName
                            .. " [" .. distance .. " studs]"
                    end
                end
            end
        end

        -- Auto TP when the Beast is nearby.
        if autoSafe and root then
            local beastRoot = getBeastRoot()

            if beastRoot then
                local distance =
                    (root.Position - beastRoot.Position).Magnitude

                if distance <= detectorRadius
                    and os.clock() - lastSafeTP >= 2 then

                    lastSafeTP = os.clock()
                    teleportToSafezone()
                end
            end
        end

        -- Recreate ESP if the Beast model changes.
        if espBeast then
            local beast = workspace:FindFirstChild("Beast", true)
            if beast and beast:IsA("Model") then
                if not beastHighlight
                    or beastHighlight.Adornee ~= beast then
                    refreshBeastESP()
                end
            end
        end
    end
end)

