local function clearESP(key)
    local data = espObjects[key]
    if not data then return end

    for _, object in ipairs(data) do
        if object and object.Parent then
            object:Destroy()
        end
    end

    espObjects[key] = nil
end

local function addPlayerESP(player, color, key)
    clearESP(key)

    local character = getCharacter(player)
    local root = getRoot(player)
    if not character or not root then return end

    local highlight = create("Highlight", {
        Name = "NEOHUB_ESP",
        Adornee = character,
        FillColor = color,
        OutlineColor = color,
        FillTransparency = 0.85,
        OutlineTransparency = 0
    }, gui)

    local billboard = create("BillboardGui", {
        Name = "NEOHUB_ESP_Label",
        Adornee = root,
        Size = UDim2.fromOffset(170, 38),
        StudsOffset = Vector3.new(0, 3, 0),
        AlwaysOnTop = true
    }, gui)

    local label = create("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        TextColor3 = color,
        TextStrokeTransparency = 0.3,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        Text = player.DisplayName
    }, billboard)

    espObjects[key] = {highlight, billboard, label}
end

local function refreshSurvivorESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local key = "survivor_" .. player.UserId

            if espSurvivors then
                addPlayerESP(player, GREEN, key)
            else
                clearESP(key)
            end
        end
    end
end

