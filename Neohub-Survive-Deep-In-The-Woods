local function create(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or BLUE,
        Thickness = thickness or 1,
        Transparency = 0.15
    }, parent)
end

local function makeLabel(parent, text, size, position, fontSize)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = position,
        Text = text,
        TextColor3 = WHITE,
        TextSize = fontSize or 13,
        Font = Enum.Font.GothamMedium,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

local function makeButton(parent, text, callback, color)
    local button = create("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = color or PANEL,
        Text = text,
        TextColor3 = WHITE,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = true
    }, parent)

    corner(button, 7)
    stroke(button, color or BLUE, 1)

    button.Activated:Connect(function()
        if callback then
            callback()
        end
    end)

    return button
end

local function makeInput(parent, placeholder, defaultText)
    local box = create("TextBox", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = DARK,
        Text = defaultText or "",
        PlaceholderText = placeholder,
        TextColor3 = WHITE,
        PlaceholderColor3 = Color3.fromRGB(140, 150, 170),
        TextSize = 12,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, parent)

    corner(box, 7)
    stroke(box, BLUE, 1)

    return box
end

local function makeToggle(parent, title, initial, callback)
    local state = initial or false

    local button = makeButton(
        parent,
        title .. " : " .. (state and "ON" or "OFF"),
        nil,
        PANEL
    )

    local function refresh()
        button.Text = title .. " : " .. (state and "ON" or "OFF")
        button.BackgroundColor3 = state
            and Color3.fromRGB(18, 65, 100)
            or PANEL
    end

    button.Activated:Connect(function()
        state = not state
        refresh()
        callback(state)
    end)

    refresh()
    return button
end

