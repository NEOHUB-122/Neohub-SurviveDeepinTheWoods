--==================================================
-- SAFEZONE TELEPORT
-- Uses BaseParts named SafeZone, SafeZoneSpawn,
-- or SpawnLocation as destinations.
--==================================================

local function findSafeParts()
    local results = {}

    for _, object in ipairs(workspace:GetDescendants()) do
        if object:IsA("BasePart") then
            local name = string.lower(object.Name)

            if name == "safezone"
                or name == "safezone_spawn"
                or name == "safezonespawn"
                or object:IsA("SpawnLocation") then

                table.insert(results, object)
            end
        end
    end

    return results
end

local function teleportToSafezone()
    local character = getCharacter(LocalPlayer)
    local root = getRoot(LocalPlayer)
    if not character or not root then return end

    local safeParts = findSafeParts()
    if #safeParts == 0 then
        warn("NEOHUB: Add a BasePart named SafeZone or SafeZoneSpawn.")
        return
    end

    local destination = safeParts[math.random(1, #safeParts)]

    character:PivotTo(
        destination.CFrame + Vector3.new(0, 4, 0)
    )
end

local function getBeastRoot()
    local beast = workspace:FindFirstChild("Beast", true)
    if not beast or not beast:IsA("Model") then return nil end

    return beast:FindFirstChild("HumanoidRootPart")
        or beast.PrimaryPart
end

